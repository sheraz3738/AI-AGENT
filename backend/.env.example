# Copy to .env on the server. Never commit real credentials.
APP_ENV=development
PORT=8000

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace_with_random_webhook_verification_token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v27.0

# AI provider (add only after choosing and creating an account)
AI_API_KEY=
AI_MODEL=

# Telephony provider (must support your chosen Pakistan call-routing arrangement)
VOICE_PROVIDER=
VOICE_PROVIDER_AUTH_TOKEN=
VOICE_PROVIDER_NUMBER=

# Owner alerts
OWNER_PHONE=03343738405
